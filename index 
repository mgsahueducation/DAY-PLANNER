<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Daily Work Planner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#e9eff0; --surface:#ffffff; --ink:#1b2a33; --muted:#62747e; --line:#d3dde0;
  --accent:#0f766e; --accent-ink:#ffffff; --now:#fff3d1; --now-bar:#e8a500; --done:#9aa9b0;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#10181c; --surface:#18232a; --ink:#e6eef0; --muted:#8fa3ac; --line:#2a3a43;
    --accent:#3cc4b4; --accent-ink:#06201d; --now:#2c2a1a; --now-bar:#f2b84b; --done:#5d727c;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#10181c; --surface:#18232a; --ink:#e6eef0; --muted:#8fa3ac; --line:#2a3a43;
  --accent:#3cc4b4; --accent-ink:#06201d; --now:#2c2a1a; --now-bar:#f2b84b; --done:#5d727c;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.45}
.wrap{max-width:720px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:16px}
.clock{font-size:clamp(44px,12vw,72px);font-weight:700;letter-spacing:-0.03em;line-height:1;font-variant-numeric:tabular-nums}
.clock small{font-size:.35em;font-weight:500;color:var(--muted);margin-left:6px;letter-spacing:0}
.date{display:flex;align-items:center;gap:6px;color:var(--muted);font-weight:500}
.date strong{color:var(--ink);min-width:11ch;text-align:center}
button{font:inherit;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:7px 12px}
button:hover{border-color:var(--accent)}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.progress{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:16px}
.progress-top{display:flex;justify-content:space-between;font-size:14px;color:var(--muted);margin-bottom:8px}
.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .3s}
section{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:16px}
h2{font-size:17px;margin:0 0 10px}
.prio{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.prio b{width:26px;height:26px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-size:13px;flex:none}
input[type=text],textarea{width:100%;font:inherit;color:var(--ink);background:transparent;border:0;border-bottom:1px solid var(--line);padding:6px 2px;border-radius:0}
textarea{border:1px solid var(--line);border-radius:8px;padding:10px;min-height:96px;resize:vertical}
.row{display:grid;grid-template-columns:64px 1fr 28px;gap:10px;align-items:center;padding:6px 8px;border-left:4px solid transparent;border-radius:6px}
.row+.row{border-top:1px solid var(--line)}
.row .t{font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums}
.row.now{background:var(--now);border-left-color:var(--now-bar)}
.row.now .t{color:var(--ink);font-weight:700}
.row.done input[type=text]{text-decoration:line-through;color:var(--done)}
input[type=checkbox]{width:20px;height:20px;accent-color:var(--accent);cursor:pointer}
.actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
@media print{.actions,.nav,#theme{display:none}body{background:#fff}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="clock" id="clock" aria-live="off">--:--</div>
    <div>
      <div class="date nav">
        <button id="prev" aria-label="Previous day">‹</button>
        <strong id="dateLabel"></strong>
        <button id="next" aria-label="Next day">›</button>
        <button id="today">Today</button>
      </div>
    </div>
  </header>

  <div class="progress">
    <div class="progress-top"><span id="progText">0 of 0 blocks done</span><span id="progPct">0%</span></div>
    <div class="bar"><i id="progBar"></i></div>
  </div>

  <section>
    <h2>Top 3 priorities</h2>
    <div id="prios"></div>
  </section>

  <section>
    <h2>Schedule</h2>
    <div id="rows"></div>
  </section>

  <section>
    <h2>Notes</h2>
    <textarea id="notes" placeholder="Ideas, follow-ups, things to remember…"></textarea>
  </section>

  <div class="actions">
    <button id="theme">Toggle theme</button>
    <button id="print">Print</button>
    <button id="clear" class="primary">Clear this day</button>
  </div>
</div>

<script>
(function(){
  var START=6, END=21; // 6 AM to 9 PM blocks
  var view=new Date(); view.setHours(0,0,0,0);
  var state={p:["","",""],s:{},n:""};

  function key(d){return "planner:"+d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
  function load(){
    state={p:["","",""],s:{},n:""};
    try{var r=localStorage.getItem(key(view)); if(r){var o=JSON.parse(r); if(o&&o.p)state=o;}}catch(e){}
  }
  function save(){try{localStorage.setItem(key(view),JSON.stringify(state));}catch(e){}}
  function label(h){var ap=h>=12?"PM":"AM",x=h%12||12;return x+":00 "+ap;}
  function el(id){return document.getElementById(id);}

  function render(){
    el("dateLabel").textContent=view.toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric"});
    var pr=el("prios"); pr.innerHTML="";
    state.p.forEach(function(v,i){
      var d=document.createElement("div"); d.className="prio";
      d.innerHTML='<b>'+(i+1)+'</b><input type="text" aria-label="Priority '+(i+1)+'" placeholder="What matters most today?">';
      var inp=d.querySelector("input"); inp.value=v;
      inp.addEventListener("input",function(){state.p[i]=inp.value;save();});
      pr.appendChild(d);
    });
    var rows=el("rows"); rows.innerHTML="";
    for(var h=START;h<=END;h++){(function(h){
      var s=state.s[h]||{t:"",d:false};
      var r=document.createElement("div"); r.className="row"; r.dataset.h=h;
      r.innerHTML='<span class="t">'+label(h)+'</span><input type="text" aria-label="Plan for '+label(h)+'" placeholder="Add a task or meeting"><input type="checkbox" aria-label="Mark '+label(h)+' done">';
      var inp=r.querySelector('input[type=text]'), cb=r.querySelector('input[type=checkbox]');
      inp.value=s.t; cb.checked=!!s.d; if(s.d)r.classList.add("done");
      function upd(){state.s[h]={t:inp.value,d:cb.checked};r.classList.toggle("done",cb.checked);save();progress();}
      inp.addEventListener("input",upd); cb.addEventListener("change",upd);
      rows.appendChild(r);
    })(h);}
    el("notes").value=state.n||"";
    progress(); tick();
  }

  function progress(){
    var total=0,done=0;
    for(var h=START;h<=END;h++){var s=state.s[h]; if(s&&s.t.trim()){total++; if(s.d)done++;}}
    var pct=total?Math.round(done/total*100):0;
    el("progText").textContent=done+" of "+total+" planned blocks done";
    el("progPct").textContent=pct+"%";
    el("progBar").style.width=pct+"%";
  }

  function tick(){
    var n=new Date();
    var h=n.getHours(), m=String(n.getMinutes()).padStart(2,"0");
    el("clock").innerHTML=(h%12||12)+":"+m+"<small>"+(h>=12?"PM":"AM")+"</small>";
    var isToday=key(n)===key(view);
    document.querySelectorAll(".row").forEach(function(r){
      r.classList.toggle("now",isToday&&Number(r.dataset.h)===h);
    });
  }

  function shift(d){view.setDate(view.getDate()+d);load();render();}
  el("prev").onclick=function(){shift(-1);};
  el("next").onclick=function(){shift(1);};
  el("today").onclick=function(){view=new Date();view.setHours(0,0,0,0);load();render();};
  el("notes").addEventListener("input",function(e){state.n=e.target.value;save();});
  el("print").onclick=function(){window.print();};
  el("clear").onclick=function(){
    if(confirm("Clear everything planned for this day?")){state={p:["","",""],s:{},n:""};save();render();}
  };
  el("theme").onclick=function(){
    var root=document.documentElement;
    var dark=root.getAttribute("data-theme")==="dark"||(root.getAttribute("data-theme")!=="light"&&matchMedia("(prefers-color-scheme: dark)").matches);
    root.setAttribute("data-theme",dark?"light":"dark");
  };

  load(); render(); setInterval(tick,15000);
})();
</script>
</body>
</html>
